export function createDemoCatalog() {
  return demoNames.map((name, index) => ({
    id: `card-${index + 1}`,
    name,
    universe: UNIVERSES[index % UNIVERSES.length].name,
    rarity: (['C', 'UC', 'R', 'SP', 'UR', 'E', 'L'] as const)[index % 7],
    variant: (['standard', 'shiny', 'alternative', 'manga', 'gold', 'rainbow', 'secret'] as const)[index % 7],
    edition: `Ext. ${index + 1}`,
    image: `https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&fit=crop&w=900&q=80`,
    power: 80 + ((index * 17) % 60),
    hp: 120 + ((index * 13) % 80)
  }));
}

export const DEMO_CATALOG = createDemoCatalog();
